# The headers of the published site (Cloudflare reads this file; scripts/serve.mjs too).
# The map frames of the recipes and of /play have an opaque origin (app/utils/map-frame.ts), so the files of the
# library need CORS.
/lib/*
  Access-Control-Allow-Origin: *
# The PMTiles file of the PMTiles recipe (scripts/natural-earth-pmtiles.mjs), which pages of other origins read with range requests.
/data/*
  Access-Control-Allow-Origin: *
  Access-Control-Expose-Headers: Content-Range, Content-Length, ETag
  Cache-Control: public, max-age=86400
# The wide and the dark first paints of the home page (scripts/first-paint.mjs). The file changes only when the script writes it again.
/home-first-paint-wide.svg
  Cache-Control: public, max-age=86400
/home-first-paint-wide-dark.svg
  Cache-Control: public, max-age=86400
/home-first-paint-dark.svg
  Cache-Control: public, max-age=86400
