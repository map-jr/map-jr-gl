{
  "name": "tessera-map",
  "version": "1.0.0",
  "description": "A small vector map renderer for the web with worker rendering, server rendering and canvas markers; reads MapLibre styles.",
  "scripts": {
    "test": "pnpm test:unit && pnpm test:expressions && pnpm test:api",
    "build": "tsc -p . && node build.mjs && tsc -p tsconfig.types.json",
    "demo": "node build.mjs && node demo/serve.mjs",
    "test:cloudflare": "node test/cloudflare/run.mjs",
    "test:unit": "node --experimental-transform-types --no-warnings --test test/unit/*.test.ts",
    "test:expressions": "node test/conformance/expressions.mjs --min=281",
    "test:api": "node test/conformance/api.mjs --min=104",
    "test:browser": "node test/interact.mjs .cache/shots",
    "bench": "node test/bench/compare.mjs",
    "test:loading": "node test/loading.mjs",
    "test:render": "node test/conformance/render.mjs --min=440"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@americana/maplibre-shield-generator": "^0.2.1",
    "@takumi-rs/core": "^2.20.0",
    "@takumi-rs/wasm": "^2.20.0",
    "@types/earcut": "^3.0.0",
    "earcut": "^3.2.4",
    "esbuild": "^0.28.2",
    "maplibre-gl": "^6.17.0",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.28.0",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/tessera.js"
    },
    "./standalone": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/tessera-standalone.js"
    },
    "./server": {
      "types": "./dist/types/server.d.ts",
      "import": "./dist/server.js"
    },
    "./worker": "./dist/tessera-worker.js",
    "./package.json": "./package.json"
  },
  "module": "./dist/tessera.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "sideEffects": false
}
