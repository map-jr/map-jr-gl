{
  "name": "@map-jr/map-jr-gl",
  "version": "0.3.0",
  "description": "A small vector map renderer for the web with worker rendering, server rendering and canvas markers; reads MapLibre styles.",
  "scripts": {
    "test": "pnpm test:unit && pnpm test:expressions && pnpm test:api && pnpm test:size && pnpm test:examples && pnpm test:consistency",
    "test:consistency": "node scripts/check-consistency.mjs",
    "test:examples": "node test/examples.mjs",
    "test:size": "node scripts/size-check.mjs",
    "test:package": "node scripts/check-package.mjs",
    "build": "tsc -p . && node build.mjs",
    "demo": "node build.mjs && node scripts/site.mjs && node demo/serve.mjs",
    "site": "node build.mjs && node scripts/site.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "status": "node scripts/status.mjs",
    "test:cloudflare": "node test/cloudflare/run.mjs",
    "test:unit": "node --experimental-transform-types --no-warnings --test test/unit/*.test.ts",
    "test:expressions": "node test/conformance/expressions.mjs --min=325",
    "test:api": "node test/conformance/api.mjs --min=112",
    "test:browser": "node test/interact.mjs .cache/shots && node test/host.mjs",
    "bench": "node test/bench/compare.mjs",
    "test:loading": "node test/loading.mjs",
    "test:vue": "node test/vue.mjs",
    "test:react": "node test/react.mjs",
    "test:render": "node test/conformance/render.mjs --min=815"
  },
  "keywords": [
    "map",
    "maps",
    "webgl",
    "webgl2",
    "vector-tiles",
    "maplibre",
    "maplibre-gl",
    "mapbox-style",
    "pmtiles",
    "geojson",
    "offscreencanvas",
    "web-worker",
    "server-rendering",
    "vue",
    "nuxt",
    "react",
    "svelte"
  ],
  "author": "Sam Margulies <sam@belabor.org>",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@takumi-rs/core": "^2.20.0",
    "@takumi-rs/wasm": "^2.20.0",
    "@types/earcut": "^3.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "earcut": "^3.2.4",
    "esbuild": "^0.28.2",
    "magic-string": "^1.4.5",
    "maplibre-gl": "^6.17.0",
    "miniflare": "^4.20260730.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dom-next14": "npm:react-dom@18.3.0-canary-178c267a4e-20241218",
    "react-next14": "npm:react@18.3.0-canary-178c267a4e-20241218",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vue": "^3.5.45"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.28.0",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "development": "./dist/map-jr-gl.dev.js",
      "import": "./dist/map-jr-gl.js",
      "default": "./dist/map-jr-gl.js"
    },
    "./maplibre-compat": {
      "types": "./dist/types/maplibre-compat.d.ts",
      "development": "./dist/map-jr-gl-maplibre-compat.dev.js",
      "import": "./dist/map-jr-gl-maplibre-compat.js",
      "default": "./dist/map-jr-gl-maplibre-compat.js"
    },
    "./controls": {
      "types": "./dist/types/control-specs.d.ts",
      "development": "./dist/controls.dev.js",
      "import": "./dist/controls.js",
      "default": "./dist/controls.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "development": "./dist/react.dev.js",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./svelte": {
      "types": "./dist/types/svelte.d.ts",
      "development": "./dist/svelte.dev.js",
      "import": "./dist/svelte.js",
      "default": "./dist/svelte.js"
    },
    "./nuxt": {
      "types": "./dist/types/nuxt.d.ts",
      "development": "./dist/nuxt.dev.js",
      "import": "./dist/nuxt.js",
      "default": "./dist/nuxt.js"
    },
    "./vue": {
      "types": "./dist/types/vue.d.ts",
      "development": "./dist/vue.dev.js",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./standalone": {
      "types": "./dist/types/standalone.d.ts",
      "import": "./dist/map-jr-gl-standalone.js",
      "default": "./dist/map-jr-gl-standalone.js"
    },
    "./maplibre-compat/standalone": {
      "types": "./dist/types/maplibre-compat.d.ts",
      "import": "./dist/map-jr-gl-maplibre-compat-standalone.js",
      "default": "./dist/map-jr-gl-maplibre-compat-standalone.js"
    },
    "./server": {
      "types": "./dist/types/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./worker": {
      "types": "./dist/types/worker.d.ts",
      "default": "./dist/map-jr-gl-worker.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/map-jr-gl.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "ACKNOWLEDGEMENTS.md",
    "THIRD-PARTY-LICENSES.md",
    "docs/*.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/map-jr/map-jr-gl.git"
  },
  "homepage": "https://map-jr.github.io/map-jr-gl/",
  "bugs": {
    "url": "https://github.com/map-jr/map-jr-gl/issues"
  }
}
